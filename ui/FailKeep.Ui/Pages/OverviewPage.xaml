<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FailKeep.Ui.Pages.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="概览" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="ConnText" Opacity="0.7" Text="正在连接服务…" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="24 小时" Opacity="0.7"/>
                        <TextBlock x:Name="C24" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="3 天" Opacity="0.7"/>
                        <TextBlock x:Name="C3" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="7 天" Opacity="0.7"/>
                        <TextBlock x:Name="C7" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="全部" Opacity="0.7"/>
                        <TextBlock x:Name="Call" Text="—" FontSize="28" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="CurrentText" Text="当前在封：—" />
            <CommandBar DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="刷新" Click="Refresh_Click" />
            </CommandBar>
            <TextBlock Text="最近攻击 IP" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="RecentList" MaxHeight="420">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Ip}" FontFamily="Consolas"/>
                            <TextBlock Grid.Column="1" Text="{Binding Geo}"/>
                            <TextBlock Grid.Column="2" Text="{Binding Tier}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Meta}" Opacity="0.7"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
