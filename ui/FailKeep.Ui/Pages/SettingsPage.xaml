<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="FailKeep.Ui.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Padding="24">
        <TextBlock Text="设置 / 关于" Style="{StaticResource TitleTextBlockStyle}"/>
        <TextBlock x:Name="IpcPathText" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <Button Content="重新检测服务" Click="Ping_Click"/>
        <TextBlock Opacity="0.7" TextWrapping="Wrap"
                   Text="UI 仅通过本机 IPC 与 FailKeep 服务通信，不直接改防火墙。请先安装并启动服务。配置文件默认 C:\ProgramData\FailKeep\config.toml。GeoIP 需自行放置 mmdb 并在配置中启用 geo 功能编译。" />
        <TextBlock Text="FailKeep-ui 0.2 · WinUI 3" Opacity="0.5"/>
    </StackPanel>
</Page>
